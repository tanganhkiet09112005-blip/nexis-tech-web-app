# ============================================================================
# NEXIS TECH — CẤU HÌNH MÔI TRƯỜNG PHÍA MÁY CHỦ (SERVER-SIDE SECRETS)
# Tuyệt đối KHÔNG thêm tiền tố VITE_ cho các biến bí mật dưới đây.
# Nhập giá trị thật vào mục Secrets của môi trường triển khai.
# ============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ----------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU LƯU TRỮ YÊU CẦU TƯ VẤN (SQLITE BỀN VỮNG)
# ----------------------------------------------------------------------------
SQLITE_DB_PATH="data/nexis_consultations.sqlite"

# ----------------------------------------------------------------------------
# 2. CẤU HÌNH THÔNG BÁO EMAIL (Gửi về cố định: nexistech.work@gmail.com)
# Chọn 1 trong 2 phương thức xác thực phía máy chủ dưới đây:
# ----------------------------------------------------------------------------

# Phương thức 2A (Khuyến nghị): Gmail / SMTP với Mật khẩu ứng dụng (App Password 16 ký tự)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="nexistech.work@gmail.com"
SMTP_PASS="YOUR_GMAIL_16_CHAR_APP_PASSWORD"
SMTP_FROM="nexistech.work@gmail.com"

# Phương thức 2B (Tùy chọn thay thế nếu dùng dịch vụ Resend API với tên miền riêng):
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="no-reply@yourdomain.com"

# ----------------------------------------------------------------------------
# 3. CẤU HÌNH THÔNG BÁO ZALO OFFICIAL ACCOUNT (ZALO OA API v3.0)
# Gửi thông báo nội bộ tới người phụ trách Nexis Tech qua endpoint:
# POST https://openapi.zalo.me/v3.0/oa/message/cs
# Lưu ý: ZALO_RECIPIENT_USER_ID là user_id (UID) của người phụ trách đối với OA,
# KHÔNG phải số điện thoại 0909 858 428.
# ----------------------------------------------------------------------------
ZALO_RECIPIENT_USER_ID="YOUR_ZALO_OA_RECIPIENT_USER_ID"
ZALO_OA_ACCESS_TOKEN="YOUR_ZALO_OA_ACCESS_TOKEN"

# Tùy chọn làm mới Access Token tự động (OAuth v4):
ZALO_APP_ID="YOUR_ZALO_APP_ID"
ZALO_APP_SECRET="YOUR_ZALO_APP_SECRET"
ZALO_OA_REFRESH_TOKEN="YOUR_ZALO_OA_REFRESH_TOKEN"
